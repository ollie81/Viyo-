{
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "public",
  "installCommand": "echo 'Flutter installs itself in buildCommand'",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "https://viyoai-production.up.railway.app/share/p/:id"
    }
  ]
}
